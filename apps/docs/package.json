{
  "name": "commitprompt-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website for Commitprompt.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "santi-og generate --config scripts/generate-og-images.mjs && astro build",
    "postbuild": "santi-og audit",
    "generate:og": "santi-og generate --config scripts/generate-og-images.mjs",
    "generate:og:force": "santi-og generate --config scripts/generate-og-images.mjs --force",
    "check:og": "santi-og check --config scripts/generate-og-images.mjs",
    "audit:seo": "santi-og audit",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "playwright test",
    "test:a11y": "playwright test",
    "test:coverage": "playwright test",
    "lint": "eslint . --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings=0",
    "check:exports": "echo \"No package exports to check\"",
    "clean": "rm -rf dist .astro coverage"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@santi020k/lumen-astro": "catalog:",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@santi020k/og": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
