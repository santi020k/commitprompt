---
import {
  Anchor,
  Breadcrumb,
  ButtonLink,
  Callout,
  Card,
  Code,
  CodeTabs,
  Icon,
  Kbd,
  Prose,
  Separator
} from '@santi020k/lumen-astro'

import Base from '../layouts/Base.astro'

const navigationItems = [
  { href: '#installation', label: 'Installation' },
  { href: '#project-setup', label: 'Project setup' },
  { href: '#configuration', label: 'Configuration' },
  { href: '#usage', label: 'Usage' },
  { href: '#editor-ai', label: 'Editor AI' },
  { href: '#commit-format', label: 'Commit format' },
  { href: '#repository-rules', label: 'Repository rules' },
  { href: '#git-hooks', label: 'Git hooks' },
  { href: '#automation-ai', label: 'Automation and AI' },
  { href: '#programmatic-api', label: 'Programmatic API' },
  { href: '#requirements', label: 'Requirements' }
]

const installItems = [
  {
    code: 'pnpm add --save-dev @santi020k/commitprompt',
    label: 'pnpm',
    language: 'shell',
    value: 'pnpm'
  },
  {
    code: 'npm install --save-dev @santi020k/commitprompt',
    label: 'npm',
    language: 'shell',
    value: 'npm'
  },
  {
    code: 'yarn add --dev @santi020k/commitprompt',
    label: 'Yarn',
    language: 'shell',
    value: 'yarn'
  }
] as const

const packageScript = `{
  "scripts": {
    "commit": "commitprompt"
  }
}`

const commitlintConfig = `export default {
  rules: {
    // 0 disables a rule, 1 warns, and 2 rejects the message.
    'header-max-length': [0],
    'body-max-line-length': [0],
    'footer-max-line-length': [0],
    'type-enum': [2, 'always', ['feat', 'fix', 'release']],
    'scope-enum': [2, 'always', ['cli', 'docs']]
  }
}`

const commitFormat = `type(scope)!: short description

Optional longer description.

BREAKING CHANGE: optional breaking change

Closes #123`

const usageCommand = 'git add src/\npnpm commit'

const hookItems = [
  {
    code: 'npx --no-install commitprompt validate --input "$1"',
    label: 'npm',
    language: 'shell',
    value: 'npm'
  },
  {
    code: 'pnpm exec commitprompt validate --input "$1"',
    label: 'pnpm',
    language: 'shell',
    value: 'pnpm'
  },
  {
    code: 'yarn run commitprompt validate --input "$1"',
    label: 'Yarn',
    language: 'shell',
    value: 'yarn'
  }
] as const

const automationExample = `commitprompt instructions --json
commitprompt scopes --json
commitprompt types --json

commitprompt format --json <<'JSON'
{
  "type": "feat",
  "scope": "cli",
  "subject": "accept structured input",
  "body": "",
  "breaking": "",
  "issues": ""
}
JSON

printf '%s\\n' 'feat(cli): accept structured input' \\
  | commitprompt validate --json`

const programmaticExample = `import { stdin, stdout } from 'node:process'
import { createInterface } from 'node:readline/promises'
import {
  createCommitlintValidator,
  createGitClient,
  runCommitFlow
} from '@santi020k/commitprompt'

const validator = createCommitlintValidator(process.cwd())
const scopes = await validator.getScopes()
const types = await validator.getTypes()
const prompt = createInterface({ input: stdin, output: stdout })

process.exitCode = await runCommitFlow({
  error: console.error,
  git: createGitClient(process.cwd()),
  log: console.log,
  prompt,
  scopes,
  types,
  validator
})`

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  description: 'Install, configure, and use Commitprompt in any Git repository.',
  headline: 'Commitprompt documentation',
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Commitprompt',
    url: 'https://commitprompt.santi020k.com/'
  },
  url: 'https://commitprompt.santi020k.com/docs/'
}
---

<Base
  title="Documentation — Commitprompt"
  description="Install, configure, and use Commitprompt in any Git repository."
  structuredData={structuredData}
>
  <div class="docs-shell shell">
    <aside class="docs-sidebar">
      <p class="docs-nav-title">In this guide</p>
      {/* Allow one pixel beyond the 7rem scroll inset for fractional layout positions. */}
      <Anchor aria-label="Documentation" activationOffset={113} items={navigationItems} />
    </aside>

    <article class="docs-content">
      <Prose>
        <header class="docs-header">
          <Breadcrumb class="docs-breadcrumb">
            <a href="/">Commitprompt</a>
            <Icon name="chevron-right" />
            <span aria-current="page">Docs</span>
          </Breadcrumb>
          <p class="docs-eyebrow">The Commitprompt guide</p>
          <h1>Commit with your repository’s rules.</h1>
          <p class="lede">
            Commitprompt is a small interactive CLI. It reads the local Commitlint
            configuration, validates the finished message, and only commits after
            you confirm it.
          </p>
          <div class="docs-meta">
            <span>{navigationItems.length} sections, one focused workflow</span>
            <span>npm · pnpm · Yarn</span>
          </div>
        </header>

        <section id="installation">
          <h2>Installation</h2>
          <p>
            Install Commitprompt. Conventional Commitlint rules are included, so
            no separate validation package or configuration is required.
          </p>
          <CodeTabs
            ariaLabel="Install Commitprompt"
            codeLabel="Install Commitprompt command"
            items={installItems}
            storageKey="commitprompt-package-manager"
            wrap={false}
          />
          <Callout>
            <p>
              Commitprompt calls the neutral <Code>commitprompt</Code> binary. The
              package command you use to install or run it is entirely your choice.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="project-setup">
          <h2>Project setup</h2>
          <p>
            Configure package metadata, repository enforcement, and AI
            instructions in one idempotent operation:
          </p>
          <Code
            code="commitprompt setup project"
            codeLabel="Set up a repository"
            copy
            label="Terminal"
            language="shell"
            variant="block"
          />
          <p>
            Setup detects npm, pnpm, or Yarn; adds Commitprompt as a development
            dependency; sets the neutral <Code>commit</Code> script; writes a
            Husky <Code>commit-msg</Code> validation hook by default; and adds
            guarded guidance to <Code>AGENTS.md</Code> and GitHub Copilot
            instructions plus reusable agent skills. Run the detected package
            manager’s install command afterward to update the lockfile and install Husky.
            Quality-managed repositories can explicitly select <Code>--only quality-hook</Code>
            and run <Code>quality hooks install</Code>.
          </p>
          <Callout>
            <p>
              Existing Commitizen, Czg, and custom prompt configuration is
              reported but never deleted. Preview with
              <Code>commitprompt setup project --dry-run</Code>, or use
              <Code>--check --json</Code> as a non-writing CI drift gate.
            </p>
          </Callout>
          <p>
            Run <Code>commitprompt setup editors</Code> to create tracked,
            repository-aware instructions in <Code>.vscode/settings.json</Code>
            and <Code>.zed/settings.json</Code>. Configured commit types and
            scopes are included without writing model preferences.
          </p>
        </section>

        <Separator />

        <section id="configuration">
          <h2>Configuration</h2>
          <p>
            Configuration is optional. Commitprompt uses Conventional Commits
            rules by default. Add a repository configuration to customize them:
          </p>
          <CodeTabs
            ariaLabel="Commitlint configuration"
            copy
            items={[{
              code: commitlintConfig,
              label: 'commitlint.config.js',
              language: 'javascript',
              value: 'config'
            }]}
          />
          <p>Then expose the neutral binary through your package scripts:</p>
          <CodeTabs
            ariaLabel="Package script"
            copy
            items={[{
              code: packageScript,
              label: 'package.json',
              language: 'json',
              value: 'package'
            }]}
          />
          <Callout>
            <p>
              Commitprompt loads configuration from the current repository. When
              it finds <Code>type-enum</Code> or <Code>scope-enum</Code>, the
              corresponding prompt follows that rule automatically.
            </p>
          </Callout>
          <p>
            Commitlint rule tuples use <Code>0</Code> to disable a rule,
            <Code>1</Code> for a warning, and <Code>2</Code> for an error.
            Commitprompt also passes through repository parser presets, plugins,
            ignores, default ignores, and help URLs when it validates a message.
            JavaScript, JSON, YAML, and erasable TypeScript configuration files
            load through Node.js without adding TypeScript to consumer
            dependencies.
          </p>
          <Callout>
            <p>
              Repository rules and <Code>extends</Code> entries take precedence
              over the built-in fallback. Undeclared rules are not enforced. When
              a resolved configuration has no <Code>extends</Code>, parser preset,
              or declared rules, Commitprompt retains its other settings and uses
              the included Conventional Commits rules.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="usage">
          <h2>Usage</h2>
          <div class="usage-grid">
            <ol>
              <li><strong>Stage</strong> the files that belong in the commit.</li>
              <li><strong>Run</strong> your repository’s commit script.</li>
              <li><strong>Describe</strong> the change with the focused prompts.</li>
              <li><strong>Finish</strong> a multiline body with an empty line.</li>
              <li><strong>Review</strong> the generated message and confirm.</li>
            </ol>
            <Code
              code={usageCommand}
              codeLabel="Stage files and start Commitprompt"
              copy
              label="Terminal"
              language="shell"
              variant="block"
            />
          </div>
          <Callout>
            <p>
              Press <Kbd>Ctrl</Kbd> + <Kbd>C</Kbd> at any time to leave the prompt.
              No commit is created until you explicitly confirm.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="editor-ai">
          <h2>Editor AI commit generation</h2>
          <p>
            Configure an editor’s native commit-message generator to use
            Commitprompt’s Conventional Commit format in every project:
          </p>
          <Code
            code={'commitprompt setup zed\ncommitprompt setup vscode'}
            codeLabel="Configure editor commit generation"
            copy
            label="Terminal"
            language="shell"
            variant="block"
          />
          <p>
            Each command updates the editor’s global settings while preserving
            comments, model selection, and existing commit-message instructions.
            They are safe to run more than once. The VS Code integration configures
            GitHub Copilot’s commit-message generation instructions; Copilot must
            be enabled for its Source Control button to be available.
          </p>
          <Callout>
            <p>
              The editor still generates the message with its configured model.
              Commitprompt supplies format instructions to the existing Source
              Control button; this does not run Commitlint validation by itself.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="commit-format">
          <h2>Commit format</h2>
          <p>The generated message follows the Conventional Commits structure:</p>
          <Code
            code={commitFormat}
            codeLabel="Conventional Commit message structure"
            copy
            label="Generated commit"
            language="text"
            variant="block"
          />
          <p>
            The type, subject, body, footer, and any repository-specific constraints
            are checked by Commitlint before confirmation.
          </p>
        </section>

        <Separator />

        <section id="repository-rules">
          <h2>Repository rules</h2>
          <p>
            Repository rules and extended configurations take precedence over
            Commitprompt’s included defaults. Custom types and scopes appear in
            the prompts, and a message that fails validation can be revised
            without restarting the CLI. Without <Code>scope-enum</Code>, scope
            remains optional and free-form.
          </p>
          <Callout>
            <p>
              Repositories without configuration still receive the complete
              Conventional Commits rule set. Validation never falls back to an
              empty rule set.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="git-hooks">
          <h2>Git hooks</h2>
          <p>
            Select <Code>--only quality-hook</Code> to add a <Code>commit-msg</Code> step to
            <Code>quality.yml</Code> that runs Commitprompt through the detected
            package manager. It preserves unrelated quality hook steps.
          </p>
          <p>
            The hook enforces the same repository rules for commits created
            directly by Git, Zed, or VS Code. A <Code>pre-commit</Code> hook runs
            before the commit message exists and is better suited to staged-file
            checks.
          </p>
          <CodeTabs
            ariaLabel="Explicit hook commands by package manager"
            codeLabel="Commit message validation hook"
            copy
            items={hookItems}
            storageKey="commitprompt-hook-package-manager"
            wrap={false}
          />
          <p>
            On failure, Commitprompt lists the violated rules, states that the
            commit was blocked, and directs the author to correct the message.
            The generated command works with npm, pnpm, and Yarn by resolving the
            repository-local Commitprompt binary through the package manager.
          </p>
        </section>

        <Separator />

        <section id="automation-ai">
          <h2>Automation and AI tools</h2>
          <p>
            AI tools can discover the repository’s allowed types and scopes, read
            generation instructions, format structured answers, and validate the
            exact result without parsing terminal prompts or bypassing repository
            rules.
          </p>
          <Code
            code={automationExample}
            codeLabel="Generate and validate a commit with structured input"
            copy
            label="Agent workflow"
            language="shell"
            variant="block"
          />
          <p>
            The <Code>format</Code> and <Code>commit</Code> commands read a JSON
            object from stdin by default. Every field is a string; optional values
            use an empty string. Use <Code>--input &lt;path&gt;</Code> to read a
            file and <Code>--cwd &lt;path&gt;</Code> to target another repository.
          </p>
          <Callout>
            <p>
              Creating a non-interactive commit requires
              <Code>commitprompt commit --yes --json</Code>. Commitprompt still
              requires staged changes, validates before calling Git, and leaves
              Git hooks enabled. Agents should only use it when the user has
              authorized the commit.
            </p>
          </Callout>
        </section>

        <Separator />

        <section id="programmatic-api">
          <h2>Programmatic API</h2>
          <p>
            The same Git, prompt, formatting, and validation pieces are exported
            independently, so you can compose a custom flow without shelling out
            to the CLI.
          </p>
          <Callout>
            <p>
              Commitprompt is ESM-only. Every value and type exported from the
              package root is stable and follows semantic versioning. Source and
              <Code>dist/</Code> file paths are implementation details, not
              supported entry points.
            </p>
          </Callout>
          <Code
            code={programmaticExample}
            codeLabel="Complete custom commit flow script"
            copy
            label="custom-commit-flow.mjs"
            language="javascript"
            variant="block"
          />
          <div class="api-grid">
            <Card as="article" variant="muted">
              <Code>runAutomation</Code>
              <p>Powers structured format, validation, discovery, and explicitly confirmed commit operations.</p>
            </Card>
            <Card as="article" variant="muted">
              <Code>runCommitFlow</Code>
              <p>Coordinates staging checks, prompts, validation, confirmation, and commit creation.</p>
            </Card>
            <Card as="article" variant="muted">
              <Code>formatCommitMessage</Code>
              <p>Formats structured answers into a complete Conventional Commit message.</p>
            </Card>
            <Card as="article" variant="muted">
              <Code>createCommitlintValidator</Code>
              <p>
                Loads repository rules or the included defaults and exposes
                validation, prompt types, and configured scopes.
              </p>
            </Card>
            <Card as="article" variant="muted">
              <Code>DEFAULT_COMMIT_TYPES</Code>
              <p>Provides the built-in feat, fix, docs, refactor, test, and maintenance choices.</p>
            </Card>
            <Card as="article" variant="muted">
              <Code>createGitClient</Code>
              <p>Checks the staged index and creates commits through Git without invoking a package manager.</p>
            </Card>
            <Card as="article" variant="muted">
              <Code>setupZed / setupVSCode</Code>
              <p>Updates editor commit-generation instructions while preserving unrelated settings.</p>
            </Card>
          </div>
          <p>
            Within a major version, additions may extend returned objects,
            exported unions, or optional options. Existing documented behavior
            and required inputs will not change incompatibly.
          </p>
        </section>

        <Separator />

        <section id="requirements">
          <h2>Requirements</h2>
          <ul>
            <li>Node.js 22.18 or newer</li>
            <li>Git</li>
            <li>At least one staged change</li>
          </ul>
          <Callout>
            <p>
              An empty index is treated as a safe stop, not an error that can
              accidentally create an empty commit.
            </p>
          </Callout>
        </section>

        <Card class="docs-cta" variant="muted">
          <div>
            <h2>Need the implementation details?</h2>
            <p>The source is small, typed, and organized by responsibility.</p>
          </div>
          <ButtonLink
            href="https://github.com/santi020k/commitprompt"
            newTab
            showArrow
            variant="secondary"
          >
            Browse the source
          </ButtonLink>
        </Card>
      </Prose>
    </article>
  </div>
</Base>
