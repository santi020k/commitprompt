---
import '../styles/home.css'

import { ButtonLink, Code, Icon, ScrollReveal } from '@santi020k/lumen-astro'

import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found — Commitprompt"
  description="The requested Commitprompt page could not be found."
  noindex
>
  <section class="cp-not-found shell" aria-labelledby="not-found-title">
    <ScrollReveal class="cp-not-found-content" animation="fade" duration="standard" threshold={0}>
      <p class="cp-eyebrow">404 / Nothing in the index</p>
      <h1 id="not-found-title">This page<br />was not staged.</h1>
      <p class="cp-home-intro">The link may have moved, or the address may be incomplete. There is still a clear path to your next commit.</p>
      <div class="cp-actions">
        <ButtonLink class="cp-action cp-action-primary" href="/" variant="unstyled">
          Go home <span class="cp-action-arrow"><Icon name="arrow-right" /></span>
        </ButtonLink>
        <ButtonLink class="cp-action cp-action-secondary" href="/docs/" variant="unstyled">
          Read the docs <Icon name="arrow-right" />
        </ButtonLink>
      </div>
    </ScrollReveal>
    <div class="cp-not-found-index" aria-hidden="true">
      <span class="cp-not-found-number">404<span>_</span></span>
      <Code code="nothing to display, working tree clean" />
      <span class="cp-not-found-caption">Good commits have context. So do good links.</span>
    </div>
  </section>
</Base>
