---
import '@santi020k/lumen-astro/styles.css'
import '../styles/global.css'

import {
  BackToTop,
  Icon,
  Link,
  NavigationMenu,
  SkipLink,
  ThemeToggle,
  UIPrimitives
} from '@santi020k/lumen-astro'

import { getSocialImageUrl } from '../lib/social-image'

interface Props {
  description: string
  noindex?: boolean
  socialImage?: string
  socialImageAlt?: string
  structuredData?: Record<string, unknown>
  title: string
}

const {
  description,
  noindex = false,
  socialImage,
  structuredData,
  title,
  socialImageAlt = title
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = getSocialImageUrl(Astro.url.pathname, Astro.site, socialImage)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('commitprompt-theme')
          const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'

          document.documentElement.dataset.theme = stored ?? preferred
        } catch {
          document.documentElement.dataset.theme = 'dark'
        }
      })()
    </script>
  </head>
  <body>
    <UIPrimitives />
    <SkipLink href="#main-content">Skip to content</SkipLink>
    <header class="site-header">
      <div class="shell nav-shell">
        <Link class="wordmark" href="/" variant="inherit">
          <img src="/icon.svg" alt="" width="30" height="30" />
          <span>commit<span>prompt</span></span>
        </Link>
        <NavigationMenu aria-label="Primary navigation" variant="unstyled">
          <Link href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</Link>
          <Link href="/docs/" aria-current={Astro.url.pathname.startsWith('/docs') ? 'page' : undefined}>Docs</Link>
          <Link href="https://github.com/santi020k/commitprompt" newTab>GitHub</Link>
          <ThemeToggle storageKey="commitprompt-theme" />
        </NavigationMenu>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <div class="shell footer-content">
        <p>Commit with intent.</p>
        <p>
          Made by <Link href="https://santi020k.com" newTab>santi020k</Link> · MIT licensed ·
          Built with Lumen.
        </p>
      </div>
    </footer>
    <BackToTop aria-label="Back to top">
      <Icon name="arrow-up" />
    </BackToTop>
  </body>
</html>
