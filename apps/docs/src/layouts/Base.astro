---
import { ClientRouter } from 'astro:transitions'

import '@santi020k/lumen-astro/styles.css'
import '../styles/global.css'

import {
  BackToTop,
  Icon,
  Link,
  NavigationMenu,
  ScrollProgress,
  SkipLink,
  ThemeToggle
} from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'
import MetadataHead from '@santi020k/og/astro/head'
import { defineSite } from '@santi020k/og/site'

import { getSocialImageUrl } from '../lib/social-image'

interface Props {
  description: string
  noindex?: boolean
  socialImage?: string
  socialImageAlt?: string
  structuredData?: Record<string, unknown>
  title: string
}

const {
  description,
  noindex = false,
  socialImage,
  structuredData,
  title,
  socialImageAlt = title
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = getSocialImageUrl(Astro.url.pathname, Astro.site, socialImage)

const site = defineSite({
  locale: 'en_US',
  siteName: 'Commitprompt',
  siteUrl: Astro.site ?? canonicalUrl
})

const page = site.page({
  description,
  image: { alt: socialImageAlt, url: socialImageUrl },
  pathname: Astro.url.pathname,
  robots: { index: !noindex },
  title
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter fallback="swap" />
    <MetadataHead {page} site={site.options} noindexPolicy="minimal" />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <script is:inline>
      (() => {
        const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
        let theme = preferred

        try {
          const stored = localStorage.getItem('commitprompt-theme')

          if (stored === 'light' || stored === 'dark') theme = stored
        } catch {
          // Use the system appearance when storage is unavailable.
        }

        document.documentElement.dataset.theme = theme
      })()
    </script>
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client'

      document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
        const theme = document.documentElement.dataset.theme

        if (theme === 'dark' || theme === 'light') {
          event.newDocument.documentElement.dataset.theme = theme
        }
      })
    </script>
  </head>
  <body>
    <UIPrimitives />
    <SkipLink href="#main-content">Skip to content</SkipLink>
    <header class="site-header">
      <div class="shell nav-shell">
        <Link
          aria-label="Commitprompt home"
          class="wordmark"
          href="/"
          variant="inherit"
        >
          <img src="/icon.svg" alt="" width="30" height="30" />
          <span>commit<span>prompt</span></span>
        </Link>
        <NavigationMenu aria-label="Primary navigation" class="primary-nav" variant="unstyled">
          <Link class="nav-home" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</Link>
          <Link href="/docs/" aria-current={Astro.url.pathname.startsWith('/docs') ? 'page' : undefined}>Docs</Link>
          <Link aria-label="Commitprompt on GitHub" href="https://github.com/santi020k/commitprompt" newTab>
            <span class="nav-github-label">GitHub</span>
            <Icon name="arrow-up-right" class="nav-external-icon" />
          </Link>
          <ThemeToggle storageKey="commitprompt-theme" />
        </NavigationMenu>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      {Astro.url.pathname.startsWith('/docs') && <ScrollProgress />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-content">
        <p class="footer-signature"><Icon name="terminal" /> Commit with intent.</p>
        <div class="footer-links">
          <span>Made by <Link href="https://santi020k.com" newTab>santi020k</Link></span>
          <Link href="https://github.com/santi020k/commitprompt/blob/main/LICENSE" newTab>MIT licensed</Link>
          <Link href="https://lumen.santi020k.com" newTab>Built with Lumen</Link>
        </div>
      </div>
    </footer>
    <BackToTop aria-label="Back to top" class="back-to-top">
      <Icon name="arrow-up" />
    </BackToTop>
  </body>
</html>
