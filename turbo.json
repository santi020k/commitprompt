{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["QUALITY_TASK_RUNTIME"],
  "globalDependencies": ["tsconfig.base.json", "tsconfig.eslint.json", "eslint.config.js", ".cspell.json"],
  "tasks": {
    "commitprompt-docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["PUBLIC_SITE_URL"],
      "outputLogs": "errors-only"
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:coverage": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**", "test-results/**"],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "check:exports": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false
    },
    "//#lint:repo": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only"
    },
    "//#lint:spell": {
      "outputLogs": "errors-only"
    },
    "//#lint:knip": {
      "outputLogs": "errors-only"
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}
