{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["commitprompt"],
  "ignoreDependencies": ["@santi020k/commitprompt", "yarn"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    "packages/commitprompt": {
      "project": ["src/**/*.ts", "bin/**/*.ts", "tests/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.astro", "src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
