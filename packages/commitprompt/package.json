{
  "name": "@santi020k/commitprompt",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "A focused, package-manager-neutral prompt for Conventional Commits.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/THIRD_PARTY_LICENSES.txt",
    "templates/**/*.md",
    "README.md",
    "AI.md",
    "LICENSE"
  ],
  "bin": {
    "commitprompt": "./dist/bin/commitprompt.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc --project tsconfig.json && node scripts/bundle-runtime.mjs",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests bin scripts --cache --no-warn-ignored --max-warnings=0",
    "lint:fix": "eslint src tests bin scripts --cache --fix --no-warn-ignored --max-warnings=0",
    "check:exports": "publint",
    "clean": "node scripts/clean.mjs dist coverage"
  },
  "dependencies": {
    "@commitlint/config-validator": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/execute-rule": "catalog:",
    "@commitlint/types": "catalog:",
    "cosmiconfig": "catalog:",
    "jsonc-parser": "catalog:"
  },
  "devDependencies": {
    "@commitlint/lint": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/santi020k/commitprompt.git",
    "directory": "packages/commitprompt"
  },
  "homepage": "https://commitprompt.santi020k.com",
  "bugs": {
    "url": "https://github.com/santi020k/commitprompt/issues"
  },
  "keywords": [
    "commit",
    "commitlint",
    "conventional-commits",
    "git",
    "prompt"
  ],
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "license": "MIT"
}
