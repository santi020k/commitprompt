# Copy this file to `.env` for local release and documentation deployment work.
# Never commit real tokens. Store production credentials in GitHub Secrets.

# Optional GitHub fine-grained token used by Changesets to create release pull
# requests. Grant Contents and Pull requests read/write access. The workflow
# falls back to GitHub's built-in token when this is unset.
CHANGESETS_TOKEN=

# npm access token used to publish commitprompt.
# Generate at https://www.npmjs.com/settings/<user>/tokens
NPM_TOKEN=

# Canonical production URL used by Astro, sitemap generation, and social tags.
PUBLIC_SITE_URL=https://commitprompt.santi020k.com

# Cloudflare Pages deployment credentials and target.
# Create an API token with Cloudflare Pages: Edit and Account Settings: Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT_NAME=commitprompt
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main

# Optional Turbo remote cache credentials and tuning.
# See https://vercel.com/docs/monorepos/remote-caching
TURBO_TOKEN=
TURBO_TEAM=
TURBO_CONCURRENCY=
TURBO_REMOTE_CACHE_TIMEOUT=
